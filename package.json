{
  "name": "catalog-ts-cicd-template",
  "version": "1.0.0",
  "description": "TypeScript + NestJS service for DayZer0 CI/CD briefs — the student builds the pipeline",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
